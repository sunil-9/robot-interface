{
  "websocket": {
    "port": 8080
  },
  "topics": [
    {
      "name": "/joint_states_for_collection",
      "type": "sensor_msgs/msg/JointState",
      "role": "state"
    },
    {
      "name": "/joint_command_for_collection",
      "type": "sensor_msgs/msg/JointState",
      "role": "command"
    },
    {
      "name": "/rgb_base",
      "type": "sensor_msgs/msg/Image",
      "role": "camera_base"
    },
    {
      "name": "/rgb_wrist",
      "type": "sensor_msgs/msg/Image",
      "role": "camera_wrist"
    },
    {
      "name": "/rgb_base_attention_mask",
      "type": "sensor_msgs/msg/Image",
      "role": "mask_base"
    },
    {
      "name": "/rgb_wrist_attention_mask",
      "type": "sensor_msgs/msg/Image",
      "role": "mask_wrist"
    },
    {
      "name": "/action_variance_windows",
      "type": "std_msgs/msg/Float64MultiArray",
      "role": "action_variance"
    }
  ],
  "maxBuffer": 1000
}
